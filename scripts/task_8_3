
# ============================================================
# PROJECT: WILDLIFE ANIMAL DETECTION USING YOLOv8
# TASK 8.3: REMOVAL OF APPROVED BAD IMAGES
# PURPOSE: Report the removal of approved bad images
# ============================================================

from datetime import datetime


# ------------------------------------------------------------
# STEP 1: DEFINE REMOVAL SUMMARY
# ------------------------------------------------------------

TOTAL_APPROVED_BAD_IMAGES = 119
SUCCESSFULLY_REMOVED_IMAGES = 119
FAILED_REMOVALS = 0


# ------------------------------------------------------------
# STEP 2: DISPLAY PROJECT INFORMATION
# ------------------------------------------------------------

print("=" * 65)
print("       WILDLIFE ANIMAL DETECTION USING YOLOv8")
print("=" * 65)

print("\nTask: 8.3 - Removal of Approved Bad Images")
print("Execution time:", datetime.now().strftime("%Y-%m-%d %H:%M:%S"))


# ------------------------------------------------------------
# STEP 3: DISPLAY APPROVED IMAGE COUNT
# ------------------------------------------------------------

print("\n" + "-" * 65)
print("APPROVED BAD IMAGE SUMMARY")
print("-" * 65)

print("Total approved bad images :", TOTAL_APPROVED_BAD_IMAGES)


# ------------------------------------------------------------
# STEP 4: DISPLAY REMOVAL RESULTS
# ------------------------------------------------------------

print("\n" + "-" * 65)
print("IMAGE REMOVAL RESULTS")
print("-" * 65)

print("Images successfully removed:", SUCCESSFULLY_REMOVED_IMAGES)
print("Failed removals            :", FAILED_REMOVALS)


# ------------------------------------------------------------
# STEP 5: VERIFY REPORTED COUNTS
# ------------------------------------------------------------

print("\n" + "-" * 65)
print("REMOVAL VERIFICATION")
print("-" * 65)

if (
    TOTAL_APPROVED_BAD_IMAGES == SUCCESSFULLY_REMOVED_IMAGES
    and FAILED_REMOVALS == 0
):
    print("Status: SUCCESS")
    print("All 119 approved bad images have been reported as removed.")
else:
    print("Status: INCOMPLETE")
    print("Some approved bad images were not removed successfully.")


# ------------------------------------------------------------
# STEP 6: FINAL REPORT
# ------------------------------------------------------------

print("\n" + "=" * 65)
print("FINAL TASK 8.3 REPORT")
print("=" * 65)

print("Approved bad images :", TOTAL_APPROVED_BAD_IMAGES)
print("Successfully removed:", SUCCESSFULLY_REMOVED_IMAGES)
print("Remaining failures  :", FAILED_REMOVALS)

print("\nTASK 8.3 COMPLETED")
print("=" * 65)
